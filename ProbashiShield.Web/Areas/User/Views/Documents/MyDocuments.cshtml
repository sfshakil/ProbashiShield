@{
    ViewData["Title"] = "My Verification Requests";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <h2>My Verification Requests</h2>
            <hr />
        </div>
    </div>
    <div class="col-md-4 text-start pb-2">
        <a href="@Url.Action("Upload", "Documents", new { area = "User" })" class="btn btn-primary">
            <i class="fas fa-cloud-upload-alt"></i> Upload New Documents
        </a>
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by Request ID...">
        </div>
        <div class="col-md-6">
            <button class="btn btn-primary" id="btnSearch">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Verification Requests List</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="verificationRequestsTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Request ID</th>
                                    <th>Requested At</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalRequestTitle">Request Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-tabs">
                    <button class="detail-tab-btn active" data-tab="docs" onclick="SwitchTab('docs')">Documents</button>
                    <button class="detail-tab-btn" data-tab="ocr" onclick="SwitchTab('ocr')">OCR Result</button>
                    <button class="detail-tab-btn" data-tab="verdict" onclick="SwitchTab('verdict')">AI &amp; Verdict</button>
                </div>

                <div id="pane-docs" class="detail-pane active">
                    <div id="docsContent" class="doc-grid-modal"></div>
                </div>
                <div id="pane-ocr" class="detail-pane">
                    <div id="ocrContent"></div>
                </div>
                <div id="pane-verdict" class="detail-pane">
                    <div id="verdictContent"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- File Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="filePreviewName"></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" id="filePreviewBody"></div>
        </div>
    </div>
</div>

<style>
    .detail-tabs {
        display: flex;
        gap: 6px;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 20px;
    }

    .detail-tab-btn {
        background: none;
        border: none;
        padding: 10px 18px;
        font-weight: 600;
        color: #888;
        border-bottom: 3px solid transparent;
        cursor: pointer;
    }

        .detail-tab-btn.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }

    .detail-pane {
        display: none;
    }

        .detail-pane.active {
            display: block;
        }

    .doc-grid-modal {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 15px;
    }

    .doc-card-modal {
        background: #f5f7fa;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        border: 2px solid #e0e0e0;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .doc-card-modal:hover {
            border-color: #667eea;
            transform: translateY(-2px);
        }

        .doc-card-modal i {
            font-size: 2rem;
            margin-bottom: 8px;
        }

        .doc-card-modal .doc-type {
            font-weight: 600;
            font-size: 0.85rem;
            color: #333;
        }

        .doc-card-modal .doc-name {
            font-size: 0.75rem;
            color: #888;
            word-break: break-word;
        }

    .kv-table {
        width: 100%;
        font-size: 0.95rem;
    }

        .kv-table td {
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }

            .kv-table td:first-child {
                color: #666;
                font-weight: 600;
                width: 45%;
            }

    .verdict-badge {
        display: inline-block;
        padding: 5px 16px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

        .verdict-badge.verified {
            background: #d4edda;
            color: #155724;
        }

        .verdict-badge.caution {
            background: #fff3cd;
            color: #856404;
        }

        .verdict-badge.highrisk {
            background: #f8d7da;
            color: #721c24;
        }

    .reason-list {
        padding-left: 18px;
        margin-bottom: 15px;
    }

    .empty-msg {
        text-align: center;
        color: #999;
        padding: 30px;
    }
</style>

@section Scripts {
    <script src="~/lib/bootstrap-datatables/js/datatables.min.js"></script>
    <script src="~/lib/bootstrap-datatables/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/bootstrap-datatables/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript">
        var dataTable;

        $(document).ready(function() {
            InitializeDataTable();

            $('#btnSearch').click(function() {
                dataTable.ajax.reload();
            });

            $('#searchInput').keypress(function(e) {
                if (e.which == 13) {
                    dataTable.ajax.reload();
                    return false;
                }
            });
        });

        function InitializeDataTable() {
            dataTable = $('#verificationRequestsTable').DataTable({
                "processing": true,
                "serverSide": true,
                "filter": false,
                "ajax": {
                    "url": "@Url.Action("GetAllVerificationRequests", "Documents", new { area = "User" })",
                    "type": "POST",
                    "datatype": "json",
                    "data": function(d) {
                        d.iDisplayStart = d.start;
                        d.iDisplayLength = d.length;
                        d.sSearch = $('#searchInput').val();
                    }
                },
                "columnDefs": [
                    {
                        "targets": 2,
                        "orderable": false,
                        "render": function(data, type, row) {
                            return `<button class="btn btn-sm btn-primary" onclick="OpenDetails(${row.id}, '${row.requestId}')">
                                                <i class="fas fa-eye"></i> View Details
                                            </button>`;
                        }
                    }
                ],
                "columns": [
                    { "data": "requestId" },
                    { "data": "requestedAt", "render": function(data) { return data ? new Date(data).toLocaleString() : ''; } },
                    { "data": null }
                ]
            });
        }

        function SwitchTab(tab) {
            document.querySelectorAll('.detail-tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
            document.querySelectorAll('.detail-pane').forEach(p => p.classList.toggle('active', p.id === 'pane-' + tab));
        }

        function OpenDetails(id, requestId) {
            document.getElementById('modalRequestTitle').textContent = 'Request #' + requestId;
            document.getElementById('docsContent').innerHTML = '<div class="empty-msg"><i class="fas fa-spinner fa-spin"></i> Loading...</div>';
            document.getElementById('ocrContent').innerHTML = '';
            document.getElementById('verdictContent').innerHTML = '';
            SwitchTab('docs');

            const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
            modal.show();

            fetch('@Url.Action("GetVerificationDetails", "Documents", new { area = "User" })?id=' + id)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) {
                        document.getElementById('docsContent').innerHTML = '<div class="empty-msg">' + data.message + '</div>';
                        return;
                    }
                    RenderDocuments(data.documents);
                    RenderOcr(data.ocrResult, id);
                    RenderVerdict(data.verdictJson, data.aiLog, id);
                })
                .catch(err => {
                    document.getElementById('docsContent').innerHTML = '<div class="empty-msg">Error loading details</div>';
                });
        }

        function RenderDocuments(docs) {
            const el = document.getElementById('docsContent');
            if (!docs || docs.length === 0) { el.innerHTML = '<div class="empty-msg">No documents uploaded</div>'; return; }
            el.innerHTML = '';
            docs.forEach(doc => {
                const isPdf = (doc.originalFileName || '').toLowerCase().endsWith('.pdf');
                const card = document.createElement('div');
                card.className = 'doc-card-modal';
                card.innerHTML = '<i class="fas ' + (isPdf ? 'fa-file-pdf text-danger' : 'fa-image text-success') + '"></i>' +
                    '<div class="doc-type">' + doc.documentType + '</div>' +
                    '<div class="doc-name">' + doc.originalFileName + '</div>';
                card.onclick = () => PreviewFile(doc.originalFileName, doc.filePath, isPdf);
                el.appendChild(card);
            });
        }

        function PreviewFile(name, filePath, isPdf) {
            document.getElementById('filePreviewName').textContent = name;
            const body = document.getElementById('filePreviewBody');
            body.innerHTML = isPdf
                ? '<embed src="' + filePath + '" type="application/pdf" width="100%" height="500px" />'
                : '<img src="' + filePath + '" style="max-width:100%; max-height:500px; border-radius:8px;" />';
            new bootstrap.Modal(document.getElementById('filePreviewModal')).show();
        }

        function RenderOcr(ocr, id) {
            const el = document.getElementById('ocrContent');
            if (!ocr) { el.innerHTML = '<div class="empty-msg">OCR not run yet</div>'; return; }
            el.innerHTML = '<table class="kv-table">' +
                Row('Agency Name', ocr.agencyName) +
                Row('License Number', ocr.licenseNumber) +
                Row('Destination Country', ocr.destinationCountry) +
                Row('Job Title', ocr.jobTitle) +
                Row('Salary', (ocr.salary ?? '-') + ' ' + (ocr.salaryCurrency || '')) +
                Row('Recruitment Fee', (ocr.recruitmentFee ?? '-') + ' ' + (ocr.recruitmentFeeCurrency || '')) +
                Row('OCR Confidence', ocr.ocrConfidence != null ? (ocr.ocrConfidence + '%') : '-') +
                Row('Processed At', ocr.processedAt ? new Date(ocr.processedAt).toLocaleString() : '-') +
                '</table>' +
                '<button type="button" class="btn btn-primary mt-2" onclick="ReRunOcr(' + id + ')"><i class="fas fa-rotate me-2"></i>Re-run OCR</button>';
        }

        async function ReRunOcr(id) {
            const el = document.getElementById('ocrContent');
            el.innerHTML = '<div class="empty-msg"><i class="fas fa-spinner fa-spin fa-2x" style="color:#667eea;"></i><p class="mt-3">Re-running OCR extraction...</p></div>';

            try {
                const ocrRes = await fetch('@Url.Action("OCRAnalysis", "Documents", new { area = "User" })?requestId=' + id, { method: 'POST' });
                const ocrData = await ocrRes.json();

                if (!ocrData.success) {
                    el.innerHTML = '<div class="empty-msg">' + ocrData.message + '</div>';
                    return;
                }

                const detailsRes = await fetch('@Url.Action("GetVerificationDetails", "Documents", new { area = "User" })?id=' + id);
                const detailsData = await detailsRes.json();

                if (detailsData.success) {
                    RenderOcr(detailsData.ocrResult, id);
                } else {
                    el.innerHTML = '<div class="empty-msg">' + detailsData.message + '</div>';
                }
            } catch (err) {
                el.innerHTML = '<div class="empty-msg">Error: ' + err.message + '</div>';
            }
        }

        function Row(label, value) {
            return '<tr><td>' + label + '</td><td>' + (value ?? '-') + '</td></tr>';
        }

        function RenderVerdict(verdictJson, aiLog, id) {
            const el = document.getElementById('verdictContent');
            if (!verdictJson) { el.innerHTML = '<div class="empty-msg">Validation not run yet</div>'; return; }

            let verdict;
            try { verdict = JSON.parse(verdictJson); } catch { el.innerHTML = '<div class="empty-msg">Unable to read verdict</div>'; return; }

            const v = (verdict.verdict || verdict.Verdict || '').toString();
            const badgeClass = v.toLowerCase().includes('verified') ? 'verified' : v.toLowerCase().includes('caution') ? 'caution' : 'highrisk';
            const reasons = verdict.reasonsBangla || verdict.ReasonsBangla || [];
            const suggestion = verdict.suggestedAction || verdict.SuggestedAction || '-';
            const bngRec = verdict.bngRecommendation || verdict.BngRecommendation || '';
            const rec = verdict.recommendation || verdict.Recommendation || '';

            let html = '<span class="verdict-badge ' + badgeClass + '">' + v + '</span>';
            html += '<h6>কারণসমূহ (Reasons)</h6>';
            html += reasons.length ? '<ul class="reason-list">' + reasons.map(r => '<li>' + r + '</li>').join('') + '</ul>' : '<p class="empty-msg">-</p>';
            html += '<h6>Suggested Action</h6><p>' + suggestion + '</p>';
            if (rec) html += '<h6>AI Recommendation</h6><p>' + rec + '</p>';
            if (bngRec) html += '<h6>AI Recommendation (বাংলা)</h6><p>' + bngRec + '</p>';
            html += '<button type="button" class="btn btn-primary mt-2" onclick="ReAnalyze(' + id + ')"><i class="fas fa-rotate me-2"></i>Re-analyze</button>';

            el.innerHTML = html;
        }

        async function ReAnalyze(id) {
            const el = document.getElementById('verdictContent');
            el.innerHTML = '<div class="empty-msg"><i class="fas fa-spinner fa-spin fa-2x" style="color:#667eea;"></i><p class="mt-3">Running AI analysis again...</p></div>';

            try {
                const res = await fetch('@Url.Action("ValidationAndAIAnalysis", "Documents", new { area = "User" })?requestId=' + id, { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    RenderVerdict(JSON.stringify(data.result), null, id);
                } else {
                    el.innerHTML = '<div class="empty-msg">' + data.message + '</div>';
                }
            } catch (err) {
                el.innerHTML = '<div class="empty-msg">Error: ' + err.message + '</div>';
            }
        }
    </script>
}